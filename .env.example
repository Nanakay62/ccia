# ==============================================================================
# Calvary Crystal Church Accounting Software — Central Monorepo Environment
# Copy this file to `.env` or `apps/web/.env`
# ==============================================================================

# Supabase Project URL (From Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (From Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# Backup Encryption Passphrase
BACKUP_PASSPHRASE=CalvaryCrystalSecureAccountingKey2026!
