# ==============================================================================
# CCIA Accounting System — Deployment Environment Configuration
# ==============================================================================

# Central PostgreSQL Configuration
POSTGRES_DB=ccia_accounting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ReplaceWithStrongProductionPassword2026!
POSTGRES_PORT=5432

# PowerSync Self-Hosted Configuration
POWERSYNC_PORT=8080
POWERSYNC_JWT_SECRET=ReplaceWithAtLeast32CharactersSecretForPowerSyncClientTokens2026

# Backup Configuration
BACKUP_PASSPHRASE=ReplaceWithSecureChurchPassphraseForEncryptedBackups2026
BACKUP_RETENTION_DAYS=30

# Web Application (Frontend build-time / runtime environment variables)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_POWERSYNC_ENDPOINT=https://sync.yourchurchdomain.org
