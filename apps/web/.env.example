# ==============================================================================
# Calvary Crystal Church Accounting Software — Supabase Online Configuration
# Copy this file to `apps/web/.env` and replace the placeholder values.
# ==============================================================================

# Supabase Project URL (From Project Settings > API > Project URL)
# Example: https://xyzcompanyproject.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (From Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# Optional: PowerSync Sync Gateway (for full multi-device bidirectional sync)
VITE_POWERSYNC_ENDPOINT=
